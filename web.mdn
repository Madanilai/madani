# موقع: عدّاد وقائمة مهام
ارسم("<h2>العدّاد</h2><button id='زر'>+1</button> <b id='ناتج'>0</b><h2>المهام</h2><input id='ادخال' placeholder='مهمة جديدة'> <button id='اضف'>إضافة</button><ul id='قائمة'></ul>")

نقرات = 0
مهام = []

دالة زيادة():
    عام نقرات
    نقرات += 1
    عنصر("#ناتج").نص = نقرات

دالة اعرض():
    عنصر("#قائمة").محتوى = مهام.خريطة(دالة(م): "<li>" + م + "</li>").اربط("")

دالة اضافة():
    مربع = عنصر("#ادخال")
    اذا مربع.قيمة != "":
        مهام.اضف(مربع.قيمة)
        مربع.قيمة = ""
        اعرض()

عنصر("#زر").عند("نقر", زيادة)
عنصر("#اضف").عند("نقر", اضافة)
