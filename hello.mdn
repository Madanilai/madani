# أساسيات اللغة
اسم = "العالم"
اطبع("مرحبا يا", اسم)

دالة مضروب(ن):
    اذا ن <= 1:
        ارجع 1
    ارجع ن * مضروب(ن - 1)

لكل ي في مدى(1, 6):
    اطبع(ي, "! =", مضروب(ي))

صنف حيوان:
    دالة بناء(اسم):
        هذا.اسم = اسم
    دالة تكلم():
        اطبع(هذا.اسم, "يصدر صوتاً")

صنف قط(حيوان):
    دالة تكلم():
        اطبع(هذا.اسم, "يقول: مواء")

لكل ك في [حيوان("شيء"), قط("ميمي")]:
    ك.تكلم()

طالب = {"اسم": "سارة", "درجات": [90، 85، 70]}
اطبع(طالب["اسم"], طول(طالب["درجات"]), طالب["درجات"][-1])
اطبع("اسم" في طالب, 5 ليس في [1, 2, 3])

عداد = 0
طالما عداد < 4:
    عداد += 1
    اذا عداد == 2:
        استمر
    اطبع("العداد", عداد)

حالة = "ناجح" اذا عداد >= 4 والا "راسب"
اطبع(حالة)

مربعات = مدى(1, 5).خريطة(دالة(س): س ** 2)
اطبع(مربعات)

حاول:
    ارفع جديد الخطأ("مشكلة!")
استثناء خ:
    اطبع("التقطت:", خ.رسالة)
اخيرا:
    اطبع("انتهى")
